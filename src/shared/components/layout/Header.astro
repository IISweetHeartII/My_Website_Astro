---
import { Github, Linkedin, Mail, Menu, Moon, Search, Sun, X } from "lucide-astro";
import SearchDialog from "@/features/blog/components/SearchDialog.astro";
import { AUTHOR_EMAIL, AUTHOR_GITHUB, AUTHOR_LINKEDIN } from "@/shared/config/consts";
import {
  getLocaleFromPathname,
  hasLocalizedCounterpart,
  type Locale,
  localeLabels,
  localeNames,
  stripLocaleFromPath,
  ui,
  withLocalePath,
} from "@/shared/i18n/ui";
import { getUrl } from "@/shared/utils/url";
import HeaderLink from "./HeaderLink.astro";

interface Props {
  locale?: Locale;
  /** Exact counterpart path, for pages that know their own translation. */
  languageSwitchHref?: string;
}

const currentLocale = Astro.props.locale ?? getLocaleFromPathname(Astro.url.pathname);
const otherLocale: Locale = currentLocale === "en" ? "ko" : "en";

// Only offer the switch where the other locale actually exists. Without this
// the button sent visitors from /about/, /resume/ and friends straight to 404.
const languageSwitchHref =
  Astro.props.languageSwitchHref ??
  (hasLocalizedCounterpart(Astro.url.pathname)
    ? withLocalePath(stripLocaleFromPath(Astro.url.pathname), otherLocale)
    : null);
const t = ui[currentLocale];
const localizedHref = (pathname: string) => getUrl(withLocalePath(pathname, currentLocale));
// KO 홈에는 ContactCTA(#contact)가 있고 EN 페이지에는 없다 → EN은 mailto로 바로.
const contactHref =
  currentLocale === "en" ? `mailto:${AUTHOR_EMAIL}` : `${localizedHref("/")}#contact`;
---

<header
  id="main-header"
  class="sticky top-0 z-50 bg-nav border-b border-nav-border transition-[background-color,box-shadow] duration-(--duration-base)"
>
  <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
    <div class="flex items-center">
      <a
        href={localizedHref("/")}
        class="flex items-center space-x-2 text-nav-text font-semibold text-lg hover:text-accent transition-ui duration-(--duration-fast) hover:bg-nav-hover/20 rounded px-2 -ml-2 py-1 whitespace-nowrap active:scale-[0.97] active:duration-(--duration-press)"
      >
        <img
          src={getUrl("/images/design/icon-48.png")}
          alt="Log8 Icon"
          width="24"
          height="24"
          class="w-6 h-6 rounded-md shrink-0"
        />
        <span class="hidden sm:inline">{t.siteTitle}</span>
      </a>
    </div>

    <div class="hidden lg:flex items-center space-x-6">
      <HeaderLink href={localizedHref("/about/")}>{t.about}</HeaderLink>
      <HeaderLink href={localizedHref("/portfolio/")}>{t.work}</HeaderLink>
      <HeaderLink href={localizedHref("/blog/")}>{t.blog}</HeaderLink>
      <HeaderLink href={localizedHref("/library/")}>{t.library}</HeaderLink>
    </div>

    <div class="flex items-center space-x-2">
      <button
        data-search-trigger
        type="button"
        class="inline-flex items-center justify-center w-9 h-9 text-nav-text/80 hover:text-nav-text hover:bg-nav-hover/20 rounded-lg transition-ui duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)"
        aria-label={t.search}
      >
        <Search class="w-5 h-5" />
      </button>

      {
        languageSwitchHref && (
          <a
            href={getUrl(languageSwitchHref)}
            class="inline-flex items-center justify-center rounded-lg border border-nav-border px-2.5 py-1.5 text-xs font-semibold text-nav-text/80 hover:bg-nav-hover/20 hover:text-nav-text transition-ui duration-(--duration-fast) active:scale-95 active:duration-(--duration-press)"
            hreflang={otherLocale}
            aria-label={`Switch language to ${otherLocale === "en" ? "English" : "Korean"}`}
          >
            {localeLabels[otherLocale]}
          </a>
        )
      }

      <button
        id="theme-toggle"
        type="button"
        class="relative inline-flex items-center justify-center w-9 h-9 text-nav-text/80 hover:text-nav-text hover:bg-nav-hover/20 rounded-lg transition-ui duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)"
        aria-label={t.themeToggle}
        aria-pressed="false"
      >
        <Sun data-icon="sun" class="theme-icon w-5 h-5" />
        <Moon data-icon="moon" class="theme-icon w-5 h-5" />
      </button>

      <!-- 협업 문의 CTA: 어느 페이지에서든 바로 연락 동선으로 -->
      <a
        href={contactHref}
        data-cta-track
        data-cta-name="header_contact"
        data-cta-section="header"
        class="hidden lg:inline-flex items-center gap-1.5 rounded-lg bg-nav-text/10 px-3 py-1.5 text-sm font-semibold text-nav-text hover:bg-nav-text/20 transition-ui duration-(--duration-fast) active:scale-95 active:duration-(--duration-press) whitespace-nowrap"
      >
        <Mail class="w-4 h-4" />
        {t.contactCta}
      </a>

      <!-- Social Icons -->
      <a
        href={AUTHOR_GITHUB}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center justify-center w-9 h-9 text-nav-text/80 hover:text-nav-text hover:bg-nav-hover/20 rounded-lg transition-ui duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)"
        title="GitHub"
      >
        <Github class="w-5 h-5" />
      </a>
      <a
        href={AUTHOR_LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center justify-center w-9 h-9 text-nav-text/80 hover:text-nav-text hover:bg-nav-hover/20 rounded-lg transition-ui duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)"
        title="LinkedIn"
      >
        <Linkedin class="w-5 h-5" />
      </a>
      <a
        href={`mailto:${AUTHOR_EMAIL}`}
        class="hidden lg:inline-flex items-center justify-center w-9 h-9 text-nav-text/80 hover:text-nav-text hover:bg-nav-hover/20 rounded-lg transition-ui duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)"
        title="Email"
      >
        <Mail class="w-5 h-5" />
      </a>

      <!-- Mobile menu toggle button -->
      <button class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg text-nav-text focus:outline-none transition-transform duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)" id="mobile-menu-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <Menu class="w-6 h-6" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu content (initially hidden) -->
  <div
    class="lg:hidden fixed inset-0 bg-nav/95 z-40 translate-x-full transition-transform duration-(--duration-panel) ease-drawer data-[state=closed]:duration-(--duration-base) data-[state=closed]:ease-out"
    id="mobile-menu"
  >
    <div class="flex justify-end p-4">
      <button class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-nav-text focus:outline-none transition-transform duration-(--duration-fast) active:scale-90 active:duration-(--duration-press)" id="mobile-menu-close" aria-label="Close menu">
        <X class="w-6 h-6" />
      </button>
    </div>
    <nav class="flex flex-col items-center space-y-6 py-8">
      <a
        href={localizedHref("/about/")}
        class="text-nav-text hover:text-accent text-xl font-semibold transition-ui duration-(--duration-fast) active:scale-[0.97] active:duration-(--duration-press)"
        >{t.about}</a
      >
      <a
        href={localizedHref("/portfolio/")}
        class="text-nav-text hover:text-accent text-xl font-semibold transition-ui duration-(--duration-fast) active:scale-[0.97] active:duration-(--duration-press)"
        >{t.work}</a
      >
      <a
        href={localizedHref("/blog/")}
        class="text-nav-text hover:text-accent text-xl font-semibold transition-ui duration-(--duration-fast) active:scale-[0.97] active:duration-(--duration-press)"
        >{t.blog}</a
      >
      <a
        href={localizedHref("/library/")}
        class="text-nav-text hover:text-accent text-xl font-semibold transition-ui duration-(--duration-fast) active:scale-[0.97] active:duration-(--duration-press)"
        >{t.library}</a
      >
      {
        languageSwitchHref && (
          <a
            href={getUrl(languageSwitchHref)}
            class="text-nav-text/80 hover:text-accent text-lg font-semibold transition-colors duration-200"
            hreflang={otherLocale}
          >
            {localeNames[otherLocale]}
          </a>
        )
      }
      <!-- Mobile search button -->
      <button
        data-search-trigger
        type="button"
        class="flex items-center gap-2 text-nav-text hover:text-accent text-lg font-semibold transition-colors duration-200"
        aria-label={t.search}
      >
        <Search class="w-5 h-5" />
        <span>{t.search}</span>
      </button>
      <a
        href={contactHref}
        data-cta-track
        data-cta-name="mobile_menu_contact"
        data-cta-section="header"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-base font-semibold text-on-primary transition-ui duration-(--duration-fast) active:scale-[0.97] active:duration-(--duration-press)"
      >
        <Mail class="w-5 h-5" />
        {t.contactCta}
      </a>
      <!-- Mobile social links -->
      <div class="flex items-center space-x-4 pt-4 border-t border-nav-text/20">
        <a
          href={AUTHOR_GITHUB}
          target="_blank"
          rel="noopener noreferrer"
          class="text-nav-text/80 hover:text-nav-text transition-colors"
          title="GitHub"
        >
          <Github class="w-6 h-6" />
        </a>
        <a
          href={AUTHOR_LINKEDIN}
          target="_blank"
          rel="noopener noreferrer"
          class="text-nav-text/80 hover:text-nav-text transition-colors"
          title="LinkedIn"
        >
          <Linkedin class="w-6 h-6" />
        </a>
        <a
          href={`mailto:${AUTHOR_EMAIL}`}
          class="text-nav-text/80 hover:text-nav-text transition-colors"
          title="Email"
        >
          <Mail class="w-6 h-6" />
        </a>
      </div>
    </nav>
  </div>
</header>

<SearchDialog />

<style>
  /* 테마 토글: 아이콘을 겹쳐 두고 크로스페이드+살짝 회전. hidden 토글(순간이동) 대체 */
  #theme-toggle .theme-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  #theme-toggle:not([data-theme="dark"]) [data-icon="sun"],
  #theme-toggle[data-theme="dark"] [data-icon="moon"] {
    opacity: 0;
    transform: scale(0.6) rotate(-40deg);
  }
</style>

<script>
  import { setupMobileMenu } from "@/shared/scripts/mobile-menu";
  import { setupThemeToggle } from "@/shared/scripts/theme-toggle";

  document.addEventListener("DOMContentLoaded", () => {
    setupMobileMenu();
    setupThemeToggle();

    // Header scroll effect
    const header = document.getElementById("main-header");

    window.addEventListener("scroll", () => {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        header?.classList.add("shadow-lg", "backdrop-blur-sm", "bg-nav/95");
      } else {
        header?.classList.remove("shadow-lg", "backdrop-blur-sm", "bg-nav/95");
      }
    });
  });
</script>
