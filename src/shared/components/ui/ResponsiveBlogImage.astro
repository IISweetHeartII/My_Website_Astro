---
import { Picture } from "astro:assets";
import { getImageMeta } from "@/shared/utils/image-meta";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "lazy" | "eager";
  caption?: string;
}

const {
  src,
  alt,
  width = 1200,
  height = 675,
  class: className = "",
  loading = "lazy",
  caption,
} = Astro.props;

// 블로그 포스트에 최적화된 반응형 크기
const responsiveWidths = [400, 600, 800, 1200];
const modernFormats = ["avif", "webp"];

// public/images 경로(문자열 src)는 astro:assets가 최적화하지 못한다 — 원본 PNG(2~4MB)가 그대로 나갔다.
// scripts/build-webp.mjs 메타가 있으면 WebP <picture> 로 직접 렌더한다.
const meta = getImageMeta(src);
---

<figure class={`blog-image-container ${className}`}>
  {
    meta ? (
      <picture class="contents">
        <source type="image/webp" srcset={meta.webp} />
        <img
          src={src}
          alt={alt}
          width={meta.width}
          height={meta.height}
          loading={loading}
          decoding="async"
          fetchpriority={loading === "eager" ? "high" : undefined}
          class="blog-image"
        />
      </picture>
    ) : (
      <Picture
        src={src}
        alt={alt}
        width={width}
        height={height}
        widths={responsiveWidths}
        formats={modernFormats}
        loading={loading}
        class="blog-image"
        sizes="(max-width: 640px) 100vw, (max-width: 768px) 90vw, (max-width: 1024px) 80vw, 70vw"
      />
    )
  }
  {caption && <figcaption class="image-caption">{caption}</figcaption>}
</figure>

<style>
  .blog-image-container {
    margin: 2rem 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .blog-image {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
    object-fit: cover;
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-image:hover {
      transform: translateY(-2px);
      box-shadow:
        0 20px 25px -5px rgba(0, 0, 0, 0.15),
        0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
  }

  .image-caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    text-align: center;
    font-style: italic;
    max-width: 90%;
    line-height: 1.5;
  }

  /* 반응형 이미지 최적화 */
  @media (max-width: 640px) {
    .blog-image-container {
      margin: 1.5rem 0;
    }

    .blog-image {
      border-radius: 0.5rem;
    }

    .image-caption {
      font-size: 0.8rem;
      max-width: 95%;
    }
  }

  @media (max-width: 480px) {
    .blog-image {
      border-radius: 0.375rem;
    }
  }

  /* 고해상도 디스플레이 최적화 */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .blog-image {
      image-rendering: -webkit-optimize-contrast;
    }
  }

  /* 다크모드 지원 */
  html[data-theme="dark"] .blog-image {
    filter: brightness(0.95);
  }

  html[data-theme="dark"] .image-caption {
    color: var(--color-text-light);
  }

  /* 모션 감소 설정 */
  @media (prefers-reduced-motion: reduce) {
    .blog-image {
      transition: none;
    }

    .blog-image:hover {
      transform: none;
    }
  }

  /* 인쇄 최적화 */
  @media print {
    .blog-image-container {
      margin: 1rem 0;
      break-inside: avoid;
    }

    .blog-image {
      box-shadow: none;
      border: 1px solid var(--color-gray-300);
    }
  }
</style>
