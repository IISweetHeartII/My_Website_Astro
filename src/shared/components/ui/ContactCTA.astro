---
import { Copy, Linkedin, Mail } from "lucide-astro";
import { AUTHOR_EMAIL, AUTHOR_LINKEDIN } from "@/shared/config/consts";

interface Props {
  /** data-cta-section 값 (전환 지점 구분용) */
  ctaSection: string;
  /** 바깥 여백 등 배치용 추가 클래스 */
  class?: string;
}

const { ctaSection, class: className = "" } = Astro.props;
const mailto = `mailto:${AUTHOR_EMAIL}`;
---

<div id="contact" class={`contact-cta ${className}`}>
  <div>
    <p class="contact-cta__title">협업/의뢰 문의는 여기로 보내주세요</p>
    <p class="contact-cta__desc">
      빠른 답장은 LinkedIn DM, 상세 논의는 이메일이 가장 효율적입니다. 프로젝트 개요와 희망 일정을 남겨주시면
      24시간 안에 회신드립니다.
    </p>
  </div>
  <div class="contact-cta__actions">
    <a
      href={AUTHOR_LINKEDIN}
      target="_blank"
      rel="noopener noreferrer"
      data-cta-track
      data-cta-name="contact_linkedin"
      data-cta-section={ctaSection}
      class="contact-cta__btn contact-cta__btn--ghost"
    >
      <Linkedin size={16} />
      LinkedIn DM
    </a>
    <a
      href={mailto}
      data-cta-track
      data-cta-name="contact_email"
      data-cta-section={ctaSection}
      class="contact-cta__btn contact-cta__btn--primary"
    >
      <Mail size={16} />
      이메일 문의
    </a>
    <button
      type="button"
      class="contact-cta__btn contact-cta__btn--ghost contact-cta__copy"
      data-copy-email={AUTHOR_EMAIL}
      data-cta-track
      data-cta-name="contact_email_copy"
      data-cta-section={ctaSection}
      aria-label="이메일 주소 복사"
      title={AUTHOR_EMAIL}
    >
      <Copy size={16} />
      <span class="contact-cta__copy-label">주소 복사</span>
    </button>
  </div>
</div>

<script>
  // mailto: 는 데스크톱에서 메일 클라이언트가 없으면 아무 일도 안 일어난다 — 주소 복사 경로를 둔다.
  document.addEventListener("DOMContentLoaded", () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(".contact-cta__copy")) {
      const label = button.querySelector<HTMLElement>(".contact-cta__copy-label");
      const original = label?.textContent ?? "";
      button.addEventListener("click", async () => {
        const email = button.getAttribute("data-copy-email") ?? "";
        try {
          await navigator.clipboard.writeText(email);
          if (label) label.textContent = "복사됨 ✓";
        } catch {
          if (label) label.textContent = email; // 클립보드 불가(비보안 컨텍스트 등)면 주소를 그대로 보여준다
        }
        window.setTimeout(() => {
          if (label) label.textContent = original;
        }, 1800);
      });
    }
  });
</script>

<style>
  /* Tailwind 토큰이 있으면 그대로 쓰고, 없으면(about.astro 등 독립 페이지) 자체 팔레트로 폴백 */
  .contact-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--color-background-lighter, var(--line, #faf5ff));
    border-radius: 1rem;
    background: var(--color-background-light, var(--surface, #f9fafb));
  }

  @media (min-width: 768px) {
    .contact-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem;
    }
  }

  .contact-cta__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, var(--ink, #1a1a2e));
  }

  .contact-cta__desc {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-light, var(--muted, #4a5568));
  }

  .contact-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-cta {
    scroll-margin-top: 5rem;
  }

  .contact-cta__btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform var(--duration-press, 120ms) var(--ease-out, ease-out);
  }

  .contact-cta__btn:active {
    transform: scale(0.97);
  }

  .contact-cta__btn--ghost {
    border: 1px solid var(--color-background-lighter, var(--line, #faf5ff));
    background: var(--color-background, var(--bg, #ffffff));
    color: var(--color-text, var(--ink, #1a1a2e));
  }

  .contact-cta__btn--ghost:hover {
    border-color: var(--color-primary, var(--accent, #7c3aed));
    color: var(--color-primary, var(--accent, #7c3aed));
  }

  .contact-cta__btn--primary {
    background: var(--color-primary, var(--accent, #7c3aed));
    color: var(--color-on-primary, #ffffff);
  }

  .contact-cta__btn--primary:hover {
    background: var(--color-primary-light, var(--accent-soft, #a78bfa));
  }
</style>
