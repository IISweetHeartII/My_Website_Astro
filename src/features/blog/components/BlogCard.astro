---
import { ArrowRight } from "lucide-astro";
import FormattedDate from "@/shared/components/ui/FormattedDate.astro";
import { type Locale, withLocalePath } from "@/shared/i18n/ui";
import { getImageMeta } from "@/shared/utils/image-meta";
import { getUrl } from "@/shared/utils/url";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  slug: string;
  dataTitle: string;
  dataTags: string;
  dataDescription: string;
  dataCategory?: string;
  pageVisible?: boolean;
  featuredImage?: string;
  featuredImageAlt?: string;
  locale?: Locale;
}

const {
  title,
  description,
  date,
  slug,
  dataTitle,
  dataTags,
  dataDescription,
  dataCategory = "daily",
  pageVisible = true,
  featuredImage,
  featuredImageAlt,
  locale = "ko",
} = Astro.props;

const href = withLocalePath(`/blog/${slug}/`, locale);
const imageMeta = getImageMeta(featuredImage);
---

<article
  class:list={[
    "scroll-animate group relative rounded-2xl bg-background border border-background-lighter shadow-sm transition-ui duration-(--duration-base) ease-out overflow-hidden hover:-translate-y-1 hover:shadow-xl hover:border-primary/30 active:translate-y-0 active:scale-[0.99] active:duration-(--duration-press)",
    { hidden: !pageVisible },
  ]}
  data-title={dataTitle}
  data-tags={dataTags}
  data-description={dataDescription}
  data-category={dataCategory}
  data-page-visible={pageVisible ? "true" : "false"}
>
  <a
    href={getUrl(href)}
    class="block text-inherit no-underline h-full"
    transition:name={`blog-card-${slug}`}
  >
    {
      featuredImage && (
        <div class="relative aspect-video overflow-hidden bg-background-light">
          <picture class="contents">
            {imageMeta && <source type="image/webp" srcset={imageMeta.webp} />}
            <img
              src={featuredImage}
              alt={featuredImageAlt || title}
              width={imageMeta?.width}
              height={imageMeta?.height}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-400 ease-out group-hover:scale-105"
            />
          </picture>
        </div>
      )
    }

    <div class="relative z-10 p-7 flex flex-col gap-4 h-full">
      <!-- Accent bar -->
      <div
        class="absolute top-0 left-0 w-1.5 h-full origin-top scale-y-0 bg-linear-to-b from-primary via-accent to-primary-light rounded-r-full transition-transform duration-300 ease-out group-hover:scale-y-100"
      >
      </div>

      <div class="flex-1 flex flex-col gap-3 pl-4">
        <h2
          data-highlight="title"
          class="text-xl md:text-2xl font-bold leading-tight text-text transition-colors duration-300 group-hover:text-primary"
        >
          {title}
        </h2>
        {
          description && (
            <p
              data-highlight="description"
              class="text-text-light leading-relaxed line-clamp-2 text-sm md:text-base"
            >
              {description}
            </p>
          )
        }
      </div>

      <div class="flex justify-between items-center mt-auto pt-5 border-t border-background-lighter pl-4">
        {
          date && (
            <time class="text-sm text-text-muted font-medium">
              <FormattedDate date={date} />
            </time>
          )
        }
        <div
          class="link-arrow inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors duration-200 group-hover:text-accent"
        >
          <span>Read More</span>
          <ArrowRight
            class="w-4 h-4"
            strokeWidth={2.5}
          />
        </div>
      </div>
    </div>
  </a>
</article>
